---
import "../styles/global.css";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { DONATE_URL } from "../data/faq";
import type { FaqItem } from "../data/faq";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  donateName?: string;
  faqItems?: FaqItem[];
}

const {
  title,
  description,
  lang = "es",
  donateName,
  faqItems = [],
} = Astro.props;

function faqAnswer(item: FaqItem) {
  const steps = item.steps
    ?.map((step, index) => {
      const detail = step.rest ? ` ${step.rest}` : "";
      return `${index + 1}. ${step.lead}${detail}`;
    })
    .join(" ");
  return [item.answer, steps, item.note].filter(Boolean).join(" ");
}

const t = useTranslations(lang);
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");

const site = Astro.site ?? new URL("https://give-laboratoria.la");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL("/images/lilita/community.webp", site);
const logoURL = new URL("/images/logo-laboratoria-black.png", site);
const esURL = new URL("/", site);
const enURL = new URL("/en/", site);
const ptURL = new URL("/pt/", site);
const ogLocales = { es: "es_LA", en: "en_US", pt: "pt_BR" } as const;
const ogLocale = ogLocales[lang];
const htmlLang = lang === "pt" ? "pt-BR" : lang;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: "Laboratoria",
      url: "https://www.laboratoria.la",
      logo: {
        "@type": "ImageObject",
        url: logoURL.href,
      },
      sameAs: ["https://www.laboratoria.la"],
      description: pageDescription,
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: site.origin + "/",
      name: t("meta.siteName"),
      description: pageDescription,
      inLanguage: ["es", "en", "pt"],
      publisher: { "@id": `${site.origin}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": `${site.origin}/#website` },
      about: { "@id": `${site.origin}/#organization` },
      inLanguage: htmlLang,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageURL.href,
      },
    },
    {
      "@type": "DonateAction",
      name: donateName ?? t("hero.cta"),
      target: DONATE_URL,
      recipient: { "@id": `${site.origin}/#organization` },
    },
    ...(faqItems.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonicalURL.href}#faq`,
            isPartOf: { "@id": `${canonicalURL.href}#webpage` },
            inLanguage: htmlLang,
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: faqAnswer(item),
              },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-MZ2Z1YDRJE");
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MZ2Z1YDRJE"></script>
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":
      new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src=
      "https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,"script","dataLayer","GTM-TZCV9KDP");
    </script>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={t("meta.keywords")} />
    <meta name="author" content="Laboratoria" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0E1D25" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="es" href={esURL.href} />
    <link rel="alternate" hreflang="en" href={enURL.href} />
    <link rel="alternate" hreflang="pt-BR" href={ptURL.href} />
    <link rel="alternate" hreflang="x-default" href={esURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("meta.siteName")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={ogLocale} />
    {Object.entries(ogLocales)
      .filter(([code]) => code !== lang)
      .map(([, locale]) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:alt" content={t("meta.ogImageAlt")} />
    <meta property="og:image:width" content="1216" />
    <meta property="og:image:height" content="1824" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={t("meta.ogImageAlt")} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TZCV9KDP"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <slot />
  </body>
</html>